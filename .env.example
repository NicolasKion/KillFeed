# Copy to .env. Nothing is required: every value has a working local
# default.

# Postgres (the docker-compose instance) and the API listen address.
# DATABASE_URL=postgres://killfeed:killfeed@127.0.0.1:5446/killfeed
# BIND_ADDR=127.0.0.1:3000
# RUST_LOG=info

# APP_NAME=Killfeed

# The most cards an overlay shows and the longest time window it can ask
# for, in hours (also the age the nightly purge deletes at).
# KILLMAIL_MAX_VISIBLE=50
# KILLMAIL_MAX_AGE_HOURS=168
# The Discord link on the setup page.
# KILLFEED_DISCORD_INVITE_URL=https://discord.gg/d2NZ5DRDQe

# The EVE services. EVE_APIS_ENABLED=false fails every outgoing call at
# once without touching the network (the dev compose's default).
# EVE_APIS_ENABLED=true
# ESI_BASE_URL=https://esi.evetech.net
# ESI_MAX_RPS=20
# ZKILLBOARD_BASE_URL=https://zkillboard.com
# R2Z2_BASE_URL=https://r2z2.zkillboard.com/ephemeral
# R2Z2_MAX_CONSECUTIVE_404S=10
# HTTP_USER_AGENT="KillFeed/1.0 (https://killfeed.killmail.space; nicolaskion07@gmail.com; EVE: Nicolas Kion)"

# What runs beside the requests: the R2Z2 firehose listener (only one
# may run at a time, anywhere), the nightly purge and the queue workers.
# LISTENER_ENABLED=false
# SCHEDULER_ENABLED=true
# JOB_WORKERS=4

# Tests only.
# TEST_DATABASE_URL=postgres://killfeed:killfeed@127.0.0.1:5446/killfeed_test
